{
  // JX NEXT zone server (jx_zone).  Override any key with JX_ZONE__PORT=... or --set zone.port=...
  "zone": {
    "id": 1,
    "name": "Test Field",
    "listen": "0.0.0.0",
    "port": 17001,
    "simulation_threads": 0,     // 0 = tu quyet theo so nhan may va so map (MASTER SPEC 15)
    "rebalance_interval_s": 15,  // scheduler doi map khoi worker nong
    "tick_hz": 18,                      // the old logic loop: frame counts of npcs.txt are ticks
    // "npcres_file": "client/assets/npcres/npcs.json",   -> default: next to map_dir
    // "script_root": "D:\\ServerLinux\\server1",        -> old server folder with script\ (npc level scripts);
    //                                                   dev.py start sets JX_ZONE__SCRIPT_ROOT from config/oldgame.local.json
    "width": 8192,
    "height": 8192,
    // "spawn": { "x": 4096, "y": 4096 },   -> when set it overrides the map spawn (useful for testing a spot)
    // AOI: o luoi 256 don vi; vung nhin la hinh chu nhat theo man hinh, khong phai hinh vuong.
    // Phep chieu la (x, y/2) nen man hinh 1024x768 phu 1024 x 1536 don vi canh; 1280 x 1536 phu
    // ca client 2.0 lan client Godot (1280x720).  view_cells = 0 nghia la suy tu hai so tren.
    "cell_size": 256,
    "view_width": 1280,
    "view_height": 1536,
    "view_cells": 0,
    // Moi client duoc bao ve toi da bao nhieu NGUOI CHOI KHAC, gan nhat truoc (0 = khong gioi han).
    // Con so 100 la MAX_BROADCAST_COUNT cua ban cu (Core/Src/KRegion.h:9), nhung gio no gioi han
    // dieu client BIET chu khong cat goi tin: goi chi di toi dung nhung client da duoc bao spawn,
    // nen khong client nao giu "bong ma" hay thay quai dung song mai (server/zone/src/KInterest.cpp).
    "max_viewers": 100,
    "max_known_npcs": 300,       // cung gioi han do cho npc / quai
    "interest_period": 4,        // moi client nhin quanh lai sau bay nhieu tick (4 tick = 0,22 giay)
    "view_slack": 1,             // entity da biet chi bi bo khi ra NGOAI vung nhin bay nhieu o
    "spawn_budget": 48,          // moi lan nhin quanh bao them toi da bay nhieu entity: nguoi vao cho dong duoc bao dan qua vai tick
    // N3: di chuyen trong near_radius don vi quanh nhan vat thi bao ngay (moi EntityMove mot goi); xa hon thi gom lai,
    // cu far_period tick gui mot goi EntityMoves. near_radius 0 = 1/4 view_width (320); far_period 1 = bao ngay tat ca.
    // Cung ban kinh nay quyet dinh khi nao mot client da day (max_viewers) doi mot nguoi xa lay mot nguoi vua buoc toi gan.
    "near_radius": 0,
    "far_period": 6,
    "default_speed": 200,
    "max_players": 30000,
    "save_interval_s": 60,
    "stats_interval_s": 10,
    "test_npcs": 4,
    // their templates ("id,id,...", taken in turn) and level: weak animals to try skills on (the owner, 2026-09-18;
    // 1000..1003 were level-200 bosses with 200000 life whatever the level). dev.py assets exports their looks.
    "test_npc_templates": "11,42,5,9",
    "test_npc_level": 10,
    // n > 0: every test npc is a gold monster of kind n at once (NpcGoldTemplate.txt row n; the path of the script's
    // NPCINFO_AddBlueNpc) - JX_ZONE__TEST_NPC_GOLD=7 for the --auto proof (Kim); 0 = plain, they only roll AutoGoldenNpc on revive
    "test_npc_gold": 0,
    "seed": 1,
    // the item tables (settings\item of the old server, every version) exported by dev.py assets
    // (jxassets export-items); without them players carry nothing. New items use the newest version.
    "items_dir": "client/assets/items",
    // which table set new items are made from (the JX2 server keeps 000..004): 0 = the newest
    "item_version": 0,
    // "?gm ds <lua>" / "?gm dw <lua>" in the chat run Lua for anyone (KGMCommand.cpp) - a development
    // server only; dev.py start turns it on
    "gm_chat": false,
    // ObjData.txt / MoneyObj.txt of the old server (jxassets export-objdata): what dropped things look like
    "objdata": "client/assets/objdata.json",
    // settings/npc/player of the old server (jxassets export-player): level_exp, level_add, stamina.ini,
    // basevalue.ini - the numbers of KPlayer::LoadFrom / LevelUp; without the file built-in defaults apply
    "player_file": "client/assets/player.json",
    // settings/revivepos.ini of the old server (jxassets export-revive-pos): the revive / reference points of every
    // map - where a new character is born in its village, where the revive and SetRevPos go; missing = spawn points
    "revive_pos_file": "client/assets/revive_pos.json",
    // settings/task/missions.txt + settings/timertask.txt of the old server (jxassets export-missions): the script of a
    // mission id (OpenMission / RunMission / CloseMission / JoinMission of the script api) and the script whose OnTimer a
    // mission timer runs (StartMissionTimer); missing = missions open without scripts
    "mission_file": "client/assets/missions.json",
    // settings/faction/门派设定.ini + factionskill.txt of the old server (jxassets export-faction): the eleven factions -
    // SetFaction of the script api, the camp of a member, the branch pages of the client's skill book; missing = no faction
    "faction_file": "client/assets/faction.json",
    // settings/skills.txt of the old server (jxassets export-skills): every skill's row for KSkillManager;
    // the numbers of each level are computed by the converted skill scripts (dev.py lua) when first used
    "skills_file": "client/assets/skills.json",
    "missles_file": "client/assets/missles.json",
    // [ServerConfig] MoneyRate of gamesetting.ini: money dropped by monsters x this / 100
    "money_rate_percent": 100,
    // exported by: python tools/dev.py assets   (empty = plain 8192x8192 grid)
    "map_dir": "client/assets/maps/1",
    // every other map bundle the zone hosts (portals need the target loaded): a list like "3,7,99",
    // or "all" for every bundle under maps_dir (980 maps = 110 730 npc, 819 MB, tick 1,6 ms idle)
    "maps": "all",
    "maps_dir": "client/assets/maps",
    "map_npcs": true
  },
  "log": {
    "level": "info",
    "levels": "",
    "console": true,
    "file": "logs/zone.log"
  }
}
